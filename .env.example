# ─── Variables d'environnement requises pour Perf_commissions ────────────────
# Copier ce fichier en .env et remplir les valeurs.
#
# Sur le serveur Docker : passer via docker-compose.yml > environment:
# En local : utiliser python-dotenv ou exporter dans le shell.
# ─────────────────────────────────────────────────────────────────────────────

# MySQL
PERF_MYSQL_HOST=75.119.154.255
PERF_MYSQL_PORT=3306
PERF_MYSQL_USER=root
PERF_MYSQL_PASSWORD=
PERF_MYSQL_DATABASE=lka_perf_commissions

# SSH (maintenance serveur)
PERF_SSH_HOST=75.119.154.255
PERF_SSH_USER=root
PERF_SSH_PASS=

# Gmail IMAP / SMTP
